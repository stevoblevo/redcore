// Redcore WP1 — magnetite grain pack, TRM-proxy relax in Earth field.
// Representative volume, not a brick. Scale B by oxide fill after the run.
//
// Uniaxial Ku is the first-order paleomag picture: shape anisotropy of
// slightly elongated SD magnetite (Tauxe 2002, L/W~1.3 → Ku~1.4e4 J/m³)
// dominates cubic K1 in many natural grains. Cubic axes are WP1b.

SetGridsize(512, 512, 96)
SetCellsize(8e-9, 8e-9, 8e-9)

Msat  = 4.80e5
Aex   = 1.33e-11
Ku1   = 1.4e4
Alpha = 0.5
Temp  = 0
B_ext = vector(0, 0, 50e-6)

Ngrains := 64
for i:=0; i<Ngrains; i++ {
    cx := rand()*4.096e-6
    cy := rand()*4.096e-6
    cz := 0.1e-6 + rand()*0.56e-6
    r  := 0.12e-6 + rand()*0.18e-6
    DefRegion(i+1, Sphere(r).Transl(cx-2.048e-6, cy-2.048e-6, cz-0.384e-6))
    AnisU.SetRegion(i+1, vector(rand()-0.5, rand()-0.5, rand()-0.5))
    Ku1.SetRegion(i+1, 1.4e4)
}

Msat.SetRegion(0, 0)
m = RandomMag()
Relax()

Save(m)
Save(B_demag)
Save(mz)
TableAdd(B_demag)
TableAdd(m)
TableSave()
print("WP1 done. python python/postprocess.py <B_demag.ovf>")
